# Entornos virtuales de Python
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]

# Cachés de herramientas
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Artefactos de empaquetado
build/
dist/
*.egg-info/
src/*.egg-info/

# Resultados generados (no versionar datos pesados ni salidas de simulación)
outputs/
results/
*.vtk
*.vtu
*.pvtu
*.vti
*.h5

# Excepción: la figura de verificación 1D del proyecto sí se versiona
# (git no permite re-incluir un archivo si su directorio está excluido,
#  por eso se re-incluyen también las carpetas padre)
!proyecto/results/
proyecto/results/*
!proyecto/results/figures/
proyecto/results/figures/*
!proyecto/results/figures/*.png

# Editores y sistema
.vscode/
.idea/
*.log

# Secretos y configuración local (NO subir credenciales)
.env
*.local.yaml

# Configuración local de Claude Code (permisos personales)
.claude/settings.local.json
# Carpetas personales (NUNCA subir al repositorio)
E01_respaldo_*/
codigo_difusion/
guias/
